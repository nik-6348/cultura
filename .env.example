# ==============================================================================
# Cultura Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=cultura
APP_VERSION=0.1.0

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cultura
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/cultura
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5434/cultura

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
JWT_SECRET=development-secret-key-change-in-production-min-32-chars
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# External AI Services - Qloo API
QLOO_API_KEY=your_qloo_api_key_here
QLOO_BASE_URL=https://api.qloo.com
QLOO_TIMEOUT_SECONDS=30
QLOO_MAX_RETRIES=3

# External AI Services - TypeSafe / Jev (System One Decisions)
JEV_API_KEY=your_typesafe_jev_api_key_here
JEV_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT_SECONDS=15
JEV_ENABLE_FALLBACK=true

# External AI Services - Primary LLM Provider (OpenAI / Anthropic / Gemini)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2

# Embeddings Model (for pgvector semantic memory)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Observability - LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=cultura-dev

# Firebase Authentication (Backend Verification)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Frontend Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
